//! zolo run scripts/verify-desktop.zolo -- --cli zolo --backend vm|native|llvm
//! --executable reuses an embedded executable; --library sets the checkout.
//! UTF16 SendInput tests editing, not physical IME composition.
use std::process
use gpui_gate::{options, desktop, snapshot, restore, now_ms}
fn main() {
    let opts = options()
    if opts.help { print("verify-desktop.zolo [--cli PATH] [--backend vm|native|llvm] [--executable PATH] [--library PATH] [--startup-timeout-seconds 900] [--step-timeout-seconds 20]"); return }
    let saved = snapshot()
    defer { restore(saved) }
    let gate = desktop(opts, "desktop_smoke", "DESKTOP", "Zolo desktop verification ")
    defer { gate.cleanup() }
    gate.receipt("DESKTOP:READY:0", opts.startup_timeout)
    gate.receipt("DESKTOP:MAIN:TASK")
    let main_window = gate.window("Zolo desktop verification main")
    process.sleep(180)
    gate.optional_screenshot(main_window, "desktop-startup.png")

    gate.click(main_window, 70.0, 82.0)
    gate.text(main_window, "x")
    gate.receipt("DESKTOP:INPUT:REJECT:x")
    assert(gate.window("Zolo desktop verification main rejected") == main_window, "Validation replaced the native window")
    process.sleep(150)
    gate.text(main_window, "7")
    gate.receipt("DESKTOP:INPUT:ACCEPT:7")
    process.sleep(150)
    gate.key(main_window, 0x41, true)
    gate.text(main_window, "ação🦀日本")
    gate.receipt("DESKTOP:INPUT:ACCEPT:ação🦀日本")
    process.sleep(150)
    gate.key(main_window, 0x0D)
    gate.receipt("DESKTOP:SUBMIT:ação🦀日本")
    gate.click(main_window, 70.0, 138.0)
    gate.receipt("DESKTOP:TOGGLE:1:true")
    gate.key(main_window, 0x20)
    gate.receipt("DESKTOP:TOGGLE:2:false")
    gate.click(main_window, 70.0, 194.0)
    gate.receipt("DESKTOP:BUTTON:1")
    gate.key(main_window, 0x0D)
    gate.receipt("DESKTOP:BUTTON:2")
    gate.click(main_window, 70.0, 250.0)
    gate.receipt("DESKTOP:CONTROLS:PASS")
    gate.receipt("DESKTOP:READY:1")
    process.sleep(120)

    gate.click(main_window, 70.0, 82.0)
    gate.key(main_window, 0x0D, true)
    gate.receipt("DESKTOP:NESTED_KEY:1")
    gate.click(main_window, 70.0, 138.0)
    gate.receipt("DESKTOP:MODAL:OPEN")
    process.sleep(180)
    gate.key(main_window, 0x0D, true)
    gate.text(main_window, "a")
    gate.receipt("DESKTOP:MODAL:A:a")
    gate.key(main_window, 0x09, false, true)
    gate.key(main_window, 0x20)
    gate.receipt("DESKTOP:MODAL:SENTINEL:1")
    gate.key(main_window, 0x09)
    gate.text(main_window, "A")
    gate.receipt("DESKTOP:MODAL:A:aA")
    gate.key(main_window, 0x09)
    gate.text(main_window, "b")
    gate.receipt("DESKTOP:MODAL:B:b")
    gate.key(main_window, 0x09)
    gate.key(main_window, 0x20)
    gate.receipt("DESKTOP:MODAL:SENTINEL:2")
    gate.key(main_window, 0x09)
    gate.text(main_window, "C")
    gate.receipt("DESKTOP:MODAL:A:aAC")
    gate.key(main_window, 0x1B)
    gate.receipt("DESKTOP:MODAL:CLOSED:trap=true:key_isolation=true")
    process.sleep(120)
    gate.click(main_window, 70.0, 194.0)
    gate.receipt("DESKTOP:KEYBOARD:PASS")
    gate.receipt("DESKTOP:READY:2")
    process.sleep(120)
    gate.optional_screenshot(main_window, "desktop-split-before.png")
    gate.drag(main_window, 300.0, 170.0, 410.0, 170.0)
    gate.receipt("DESKTOP:SPLIT:RESIZED")
    process.sleep(150)
    gate.optional_screenshot(main_window, "desktop-split-after.png")
    gate.click(main_window, 70.0, 314.0)
    gate.receipt("DESKTOP:SPLIT:PASS")
    gate.receipt("DESKTOP:READY:3")
    process.sleep(120)

    gate.click(main_window, 70.0, 82.0)
    gate.receipt("DESKTOP:CHILD:OPEN")
    gate.receipt("DESKTOP:CHILD:TASK")
    let child_window = gate.window("Zolo desktop verification child")
    assert(gate.windows().len() == 2, "Expected two owned native windows")
    gate.click(main_window, 70.0, 138.0)
    gate.receipt("DESKTOP:MAIN:CLOSING")
    gate.receipt("DESKTOP:MAIN:CLEANUP")
    let deadline = now_ms() + opts.step_timeout * 1000
    while gate.windows().len() != 1 && now_ms() < deadline { gate.live(); process.sleep(20) }
    assert(gate.windows().len() == 1, "First window did not close independently")
    gate.click(child_window, 70.0, 82.0)
    gate.receipt("DESKTOP:CHILD:PING:main_open=false:cleanup=true")
    gate.click(child_window, 70.0, 138.0)
    gate.receipt("DESKTOP:CHILD:CLOSING")
    gate.receipt("DESKTOP:CHILD:CLEANUP")
    gate.receipt("DESKTOP:PASS:controls:unicode:keyboard:modal:split:multiwindow:cleanup")
    gate.finish()
    gate.record("DESKTOP_RECEIPT backend={opts.backend} source_free={gate.source_free} controls=true controlled_rejection=true unicode_utf16=true nested_shortcut=true modal_shortcut_isolation=true modal_tab_trap=true split_drag=true dynamic_multiwindow=true cleanup=true close=0 physical_ime=not_exercised")
}
main()
