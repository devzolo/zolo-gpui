//! Fixture transformations apply only to isolated test inputs.
use std::{fs, path, process, env, regex, json, string, hash}

pub struct Capture {
    status: int = -1,
    stdout: str = "",
    stderr: str = "",
    error: str = "",
}

pub fn option(args: [str], name: str) -> str? {
    let flag = "--" + name
    for i in 1..args.len() {
        if args[i] == flag {
            assert(i + 1 < args.len() && !args[i + 1].starts_with("--"), flag + " requires a value")
            return args[i + 1]
        }
        if args[i].starts_with(flag + "=") { return args[i].slice(flag.len() + 1, nil) }
    }
    return nil
}

pub fn values(args: [str], name: str) -> [str] {
    let flag = "--" + name
    var result: [str] = []
    for i in 1..args.len() {
        if args[i] == flag {
            assert(i + 1 < args.len() && !args[i + 1].starts_with("--"), flag + " requires a value")
            result.push(args[i + 1])
        }
        if args[i].starts_with(flag + "=") { result.push(args[i].slice(flag.len() + 1, nil)) }
    }
    return result
}

pub fn validate(args: [str], allowed: [str], switches: [str] = []) {
    var i = 1
    while i < args.len() {
        let token = args[i]
        if switches.contains(token) { i += 1; continue }
        let key = token.split("=")[0]
        assert(allowed.contains(key), "Unknown option: " + token)
        if token.contains("=") {
            assert(!token.ends_with("="), "Missing option value: " + token)
            i += 1
        } else {
            assert(i + 1 < args.len() && !args[i + 1].starts_with("--"), "Missing option value: " + token)
            i += 2
        }
    }
}

pub fn read(file: str) -> str { return fs.read(file) ?? panic("Cannot read " + file) }
pub fn write(file: str, text: str) { assert(fs.write(file, text) != nil, "Cannot write " + file) }
pub fn mkdir(dir: str) { assert(fs.mkdir(dir) != nil, "Cannot create " + dir) }
pub fn script_dir() -> str { return path.dirname(path.resolve(process.argv()[0])) }
pub fn executable_suffix() -> str { return if env.os() == "windows" { ".exe" } else { "" } }
pub fn selected_cli(args: [str]) -> str { return option(args, "cli") ?? env.get("ZOLO_BIN") ?? "zolo" }

fn cli_path(command: str) -> str {
    if path.is_absolute(command) || command.contains("/") || command.contains("\\") { return path.resolve(command) }
    let separator = if env.os() == "windows" { ";" } else { ":" }
    for dir in (env.get("PATH") ?? "").split(separator) {
        for suffix in ["", executable_suffix()] {
            let candidate = path.resolve(path.join(dir, command + suffix))
            if fs.is_file(candidate) { return candidate }
        }
    }
    panic("Cannot locate CLI executable: " + command)
}

pub fn capture(executable: str, args: [str], timeout_ms: int, limit: int = 4194304, input: str? = nil) -> Capture {
    var options = process::RunOptions { timeout_ms: timeout_ms, max_output_bytes: limit, max_stderr_bytes: limit }
    if input != nil { options.stdin = input.bytes() }
    match process.run(executable, args, options) {
        .Ok(output) => { return Capture.new(status: output.status, stdout: string.from_bytes(output.stdout), stderr: output.stderr) },
        .Err(message) => { return Capture.new(error: message) },
    }
}

fn remove_lines(text: str, prefixes: [str]) -> str {
    var kept: [str] = []
    for line in text.split("\n") {
        var remove = false
        for prefix in prefixes { if line.starts_with(prefix) { remove = true } }
        if !remove { kept.push(line) }
    }
    return kept.join("\n")
}

pub fn strip_provider(source: str) -> str {
    var text = remove_lines(source, ["use plugin"])
    text = regex.replace("extern rust deps %b\{\}", text, "")
    return regex.replace("extern rust from[^\{]+%b\{\}", text, "")
}

pub fn replace_once(text: str, needle: str, replacement: str) -> str {
    let index = text.index_of(needle)
    assert(index >= 0, "Fixture source changed; missing transformation: " + needle)
    return text.slice(0, index) + replacement + text.slice(index + needle.len(), nil)
}

fn fixture_resource(scripts: str, name: str) -> str { return read(path.join(scripts, "resources", name)) }

pub fn prepare_normal(args: [str], scripts: str, default_output: str = "normal-host-drain") -> str {
    let root = path.dirname(scripts)
    let source = path.resolve(option(args, "library") ?? path.join(root, "src", "lib.zolo"))
    let fixture = path.resolve(option(args, "fixture") ?? path.join(root, "tests", "normal-host-drain.zolo"))
    let dir = path.resolve(option(args, "output-dir") ?? path.join(root, "target", default_output))
    mkdir(dir)
    write(path.join(dir, "group_host.zolo"), strip_provider(read(source)) + fixture_resource(scripts, "normal-host.zolo.fixture"))
    assert(fs.copy(fixture, path.join(dir, "main.zolo")) != nil, "Cannot copy " + fixture)
    print("Prepared real-library non-GUI host-return drain oracle in " + dir)
    return dir
}

pub fn prepare_entry(args: [str], scripts: str) -> str {
    // The intermediate normal host always uses its own oracle.
    var normal_args: [str] = [args[0], "--output-dir", path.resolve(option(args, "output-dir") ?? path.join(path.dirname(scripts), "target", "entry-reload"))]
    let library = option(args, "library")
    if library != nil { normal_args.push("--library"); normal_args.push(library) }
    let dir = prepare_normal(normal_args, scripts, "entry-reload")
    let source = path.join(dir, "group_host.zolo")
    var text = read(source)
    text = replace_once(text, "use std::ui::\{collect, begin_updates, poll_updates, end_updates\}", "use std::ui::\{collect\}")
    let desktop_start = text.index_of("fn native_desktop(initial:")
    assert(desktop_start >= 0, "Missing fixture native_desktop")
    let desktop_end = text.index_of("\n}", desktop_start) + 2
    assert(desktop_end > desktop_start, "Missing native_desktop end")
    text = text.slice(0, desktop_start) + fixture_resource(scripts, "entry-desktop.zolo.fixture") + text.slice(desktop_end, nil)
    text = replace_once(text, "fn native_smoke(render:fn()->[NativeNode],dispatch:fn(int)->Any,update:fn()->NativePoll,close:fn()->bool,x:float,y:float) \{\}", fixture_resource(scripts, "entry-smoke.zolo.fixture"))
    text += fixture_resource(scripts, "entry-reload.zolo.fixture")
    write(source, text)
    let fixture = path.resolve(option(args, "fixture") ?? path.join(path.dirname(scripts), "tests", "entry-reload.zolo"))
    assert(fs.copy(fixture, path.join(dir, "main.zolo")) != nil, "Cannot copy " + fixture)
    print("Prepared entry reload publication oracle in " + dir)
    return dir
}

pub fn verify_oracle(args: [str], scripts: str, entry_reload: bool) -> int {
    validate(args, ["--library", "--fixture", "--cli", "--output-dir", "--backend"])
    let dir = if entry_reload { prepare_entry(args, scripts) } else { prepare_normal(args, scripts) }
    let cli = selected_cli(args)
    let backend_option = option(args, "backend")
    let backends: [str] = if backend_option != nil { [backend_option] } else { ["vm", "native", "llvm"] }
    var failure = 0
    for backend in backends {
        assert(["vm", "native", "llvm"].contains(backend), "Expected --backend vm, native or llvm")
        let base = path.join(dir, backend)
        let source = path.join(dir, "main.zolo")
        if backend != "vm" {
            print("Building " + backend + " oracle…")
            let build = capture(cli, ["build", source, "--emit", backend, "--release", "--plugins", "dynamic", "-o", base], 180000)
            write(base + ".build.log", build.stdout + build.stderr + build.error)
            if build.status != 0 {
                print(json.encode(#{ "backend": backend, "build_status": build.status, "error": build.error }))
                failure = 1
                continue
            }
        }
        print("Running " + backend + " oracle…")
        let run = if backend == "vm" {
            capture(cli, ["run", source, "--no-cache", "--no-build-script"], 30000)
        } else { capture(base + executable_suffix(), [], 30000) }
        let stdout = run.stdout.trim().replace("\r", "")
        let lines = stdout.split("\n")
        var passed = run.status == 0
        if entry_reload {
            for marker in ["REJECTED", "MIXED_BATCH", "ACCEPTED", "IDLE", "MULTIPLE_REPLAYS", "MODULE_INVALIDATION", "WINDOW_RETRY", "RETIRED", "LEGACY", "TRANSACTION"] {
                if !lines.contains("ENTRY:" + marker + ":PASS") { passed = false }
            }
        } else {
            for mode in 0..4 {
                if !lines.contains("HOST:DRAIN:PASS:{mode}") || !lines.contains("HOST:RECEIPT:{mode}:main=true:child_started=true:child=true:late=0") { passed = false }
            }
        }
        let receipt = json.encode(#{ "backend": backend, "status": run.status, "stdout": stdout, "passed": passed, "error": run.error })
        write(base + ".run.log", run.stdout + run.stderr + run.error)
        write(base + ".json", receipt)
        print(receipt)
        if !passed { failure = 1 }
    }
    return failure
}

pub fn verify_core(args: [str], scripts: str) -> int {
    validate(args, ["--library", "--language-root", "--cli", "--output-dir", "--append-source", "--append-fixture", "--append-stubs", "--strip-use-prefix"], ["--reify", "--run", "--pending-generic-fix"])
    let root = path.resolve(option(args, "library") ?? path.dirname(scripts))
    let language = path.resolve(option(args, "language-root") ?? env.get("ZOLO_LANGUAGE_ROOT") ?? path.join(root, "../zolo-lang"))
    let source_dir = path.join(root, "src")
    let tests_dir = path.join(root, "tests", "pure")
    let output = path.resolve(option(args, "output-dir") ?? path.join(root, "target", "pure-core"))
    mkdir(output)
    let cli = cli_path(option(args, "cli") ?? env.get("ZOLO_GPUI_TEST_CLI") ?? env.get("ZOLO_BIN") ?? "zolo")
    assert(fs.exists(cli), "Build the current Zolo CLI or supply --cli: " + cli)
    let cli_hash = match hash.sha256_file(cli, 1073741824) { .Ok(value) => value, .Err(message) => panic(message) }
    let stat = fs.stat(cli) ?? panic("Cannot stat " + cli)
    let cli_receipt = "GPUI_PURE_CLI path={cli}; sha256={cli_hash}; modified_unix={stat.modified}"
    let input_receipt = "GPUI_PURE_INPUT source={source_dir}; tests={tests_dir}; language={language}; artifacts={output}"
    print(cli_receipt)
    print(input_receipt)
    var text = strip_provider(read(path.join(source_dir, "lib.zolo")))
    if !args.contains("--reify") { text = text.replace("@reify(T)", "").replace("typeinfo(T).key", "\"preliminary-schema\"") }
    for extra in values(args, "append-source") {
        var body = strip_provider(read(path.resolve(extra)))
        body = regex.replace("use gpui::%b\{\}", body, "")
        body = remove_lines(body, values(args, "strip-use-prefix"))
        text += "\n" + body
    }
    text += fixture_resource(scripts, "native-stubs.zolo.fixture")
    for stubs in values(args, "append-stubs") { text += "\n" + read(path.resolve(stubs)) }
    if args.contains("--run") {
        assert(fs.exists(path.join(language, "crates", "zolo-vm", "Cargo.toml")) && fs.exists(path.join(language, "crates", "zolo-std", "Cargo.toml")), "--run requires a language checkout; supply --language-root")
        var fixtures = [path.join(tests_dir, "lifecycle-tests.zolo.fixture")]
        for extra in values(args, "append-fixture") { fixtures.push(path.resolve(extra)) }
        for fixture in fixtures {
            var lines: [str] = []
            for line in read(fixture).split("\n") {
                lines.push(if line.starts_with("let ") { "var " + line.slice(4, nil) } else { line })
            }
            text += "\n" + lines.join("\n")
        }
        if args.contains("--pending-generic-fix") {
            print("TEMPORARY: Entity generic method gate omitted; all schema gates remain active.")
            text = text.replace("entity_cell.update(|number| number + 1)", "").replace("assert(entity_cell.read() == 5)", "")
        }
    }
    write(path.join(output, "core-check.zolo"), text)
    print("Compiling isolated core fixture…")
    let compiled = capture(cli, ["compile", "--stdin", "--no-build-script"], 180000, 10485760, text)
    write(path.join(output, "core-check.stderr"), compiled.stderr + compiled.error)
    if compiled.status != 0 { print(compiled.stderr + compiled.error); return 1 }
    if !args.contains("--run") {
        write(path.join(output, "core-check.lua"), compiled.stdout)
        print(compiled.stderr)
        print("core compile exit={compiled.status}")
        return compiled.status
    }
    return run_core(scripts, output, language, compiled, cli_receipt, input_receipt)
}

fn run_core(scripts: str, output: str, language: str, compiled: Capture, cli_receipt: str, input_receipt: str) -> int {
    var globals = 0
    var lua_lines: [str] = []
    for line in compiled.stdout.split("\n") {
        if line.starts_with("local ") {
            globals += 1
            let declaration = line.slice(6, nil)
            if declaration.starts_with("function ") || declaration.contains("=") { lua_lines.push(declaration) }
            else {
                var nils: [str] = []
                for _ in declaration.split(",") { nils.push("nil") }
                lua_lines.push(declaration + " = " + nils.join(", "))
            }
        } else { lua_lines.push(line) }
    }
    write(path.join(output, "core-check.lua"), lua_lines.join("\n"))
    let fixture_receipt = "FIXTURE_ONLY flattened_chunk_globals={globals}; generated bodies/reified schemas unchanged; native functions stubbed"
    print(fixture_receipt)
    let runner_dir = path.join(output, "core-runner")
    mkdir(path.join(runner_dir, "src"))
    let vm_path = json.encode(path.join(language, "crates", "zolo-vm").replace("\\", "/"))
    let std_path = json.encode(path.join(language, "crates", "zolo-std").replace("\\", "/"))
    let manifest = "[package]\nname=\"gpui-core-fixture\"\nversion=\"0.0.0\"\nedition=\"2024\"\n[workspace]\n[dependencies]\nzolo-vm=\{path=" + vm_path + "\}\nzolo-std=\{path=" + std_path + "\}\n"
    write(path.join(runner_dir, "Cargo.toml"), manifest)
    write(path.join(runner_dir, "src", "main.rs"), fixture_resource(scripts, "vm-runner.rs"))
    if !fs.exists(path.join(runner_dir, "Cargo.lock")) { assert(fs.copy(path.join(language, "Cargo.lock"), path.join(runner_dir, "Cargo.lock")) != nil, "Cannot copy language lock") }
    print("Building isolated Rust VM executor (offline)…")
    let build = capture("cargo", ["build", "--offline", "--manifest-path", path.join(runner_dir, "Cargo.toml"), "--target-dir", path.join(language, "target")], 600000, 10485760)
    write(path.join(output, "core-runner.build.log"), build.stdout + build.stderr + build.error)
    if build.status != 0 { print(build.stderr + build.error); return 1 }
    let runner = path.join(language, "target", "debug", "gpui-core-fixture" + executable_suffix())
    let run = capture(runner, [path.join(output, "core-check.lua")], 30000, 10485760)
    write(path.join(output, "lifecycle-receipt.log"), cli_receipt + "\n" + input_receipt + "\n" + fixture_receipt + "\n" + run.stdout + run.stderr + run.error)
    print(run.stdout)
    print(run.stderr + run.error)
    print("lifecycle exit={run.status}")
    return if run.status == 0 { 0 } else { 1 }
}
